# Build output
android/build/
android/app/build/
android/.gradle/
desktop/build/
desktop/.gradle/
android/.kotlin/
android/local.properties
*.apk
*.aab
*.ap_
*.dex

# Node
node_modules/
npm-debug.log*
pc-agent/tools/agent-out.log
pc-agent/tools/agent-err.log
pc-agent/tools/sdk-dump-out.txt

# Large third-party binaries are downloaded, not committed.
# cloudflared is fetched per machine; see README for the download step.
tools/cloudflared-windows-amd64.exe

# Scratch / local-only
.tmp/
*.log

# Editor / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# Diagnostic run output
pc-agent/tools/*-out.txt

# Local deployment notes and secrets - NEVER commit
DEPLOYMENT.local.md
*.local.md
.local-notes/

# Local scratch artifacts (Termux bootstrap tarball, etc.)
$d/
*.tar

# Staged at build time from pc-agent/src by the syncLocalAgent Gradle task.
# The local agent travels inside the APK so it can never drift from the app's
# protocol version; the source of truth is pc-agent/.
android/app/src/main/assets/local-agent/

# Handoff bundle for the phone-side sandbox: 172 MB, over Gitee's 100 MB
# per-file limit, and it is a build product rather than source. The payload is
# reproduced by pc-agent/tools/build-local-kernel.mjs.
local-sandbox-*.zip
# Hand-made release bundles (0.31.0.zip and friends): ~100 MB each, over Gitee's
# per-file limit, and they are distributed out of band rather than versioned.
# A build product, not source - the same reason local-sandbox-*.zip is ignored.
/[0-9]*.zip