[Unit]
Description=TermDesk authenticated VPS node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=termdesk
Group=termdesk
WorkingDirectory=/opt/termdesk-relay
Environment=TERMDESK_RELAY_CONFIG=/var/lib/termdesk-relay/config.json
ExecStart=/usr/bin/node /opt/termdesk-relay/src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/termdesk-relay
MemoryMax=256M
TasksMax=64
UMask=0077

[Install]
WantedBy=multi-user.target
