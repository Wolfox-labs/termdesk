# Standalone TLS ingress. Review hostname, certificate and port before enabling.
# This is a template, not a change to an existing nginx/xray/443 deployment.
server {
    listen 8443 ssl;
    server_name relay.example.invalid;

    ssl_certificate /etc/termdesk/tls/fullchain.pem;
    ssl_certificate_key /etc/termdesk/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 40m;
    location / {
        proxy_pass http://127.0.0.1:7421;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # Overwrite rather than append an internet caller's untrusted header.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_request_buffering off;
    }
}
