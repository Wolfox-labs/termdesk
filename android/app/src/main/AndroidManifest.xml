<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      The phone-side sandbox runs as a child process of this app, and the connection to the
      paired computer has to keep being read while the app is off screen. A foreground
      service is the only supported way to tell Android "do not reap this while the app is
      in the background". FOREGROUND_SERVICE_SPECIAL_USE and FOREGROUND_SERVICE_DATA_SYNC
      are only required from targetSdk 34; they are declared now so raising targetSdk later
      does not silently break the local kernel or the notifications. POST_NOTIFICATIONS is
      likewise a no-op below targetSdk 33.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Held only while ConnectionService lives, so the socket keeps being read with the
         screen off. Released in the service's onDestroy, never outlives it. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Only used to OPEN the screen where the owner allows background running; the app never
         flips the setting itself and does not ask for anything else with it. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TermDesk"
        android:usesCleartextTraffic="true">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Pairing links from the PC's pairing page. The phone's own camera can
              scan the code and hand the address and token straight to the app.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="termdesk" android:host="pair" />
            </intent-filter>
        </activity>
        <!--
          Keeps the sandbox agent alive off-screen. Started and stopped only by
          LocalAgent, never exported, and it deliberately does not restart itself
          (START_NOT_STICKY) so it can never show "running" over a dead sandbox.
        -->
        <service
            android:name=".data.LocalAgentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's on-device Termux sandbox agent running." />
        </service>
        <!--
          Keeps the app scheduled while it is off screen, so a "your turn finished" or "the
          kernel is waiting for you" frame can still be received and drawn. Started when the
          window goes away with a live link, stopped when either comes back. Not specialUse:
          this one keeps a network connection to the paired computer, which is what `dataSync`
          is for.
        -->
        <service
            android:name=".data.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
